# ==================== 账号与宿舍 ====================
# 重庆大学统一身份认证学号。
CQU_ACCOUNT=your_student_id
# 缴费平台查询密码。
CQU_PASSWORD=your_query_password
# 房间账号，需与网页选项一致，例如 D1102
CQU_ROOM=D1102
# 网页显示的楼栋名称；无同名房间时可以留空。
CQU_BUILDING=兰园1栋

# ==================== 定时任务 ====================
# 每天抓取时间，使用 24 小时制，多个时间以英文逗号分隔。
SCHEDULE_TIMES=00:00,12:00
# 调度和数据记录使用的 IANA 时区。
TIMEZONE=Asia/Shanghai

# ==================== 邮件通知 ====================
# true：once/daemon 抓取成功后自动发送邮件；false：不自动发送。
EMAIL_ENABLED=false
# SMTP 服务器地址。
SMTP_HOST=smtp.example.com
# SMTP 端口；SSL 通常使用 465，STARTTLS 通常使用 587。
SMTP_PORT=465
# SMTP 登录用户名，通常为完整邮箱地址。
SMTP_USERNAME=your_email@example.com
# SMTP 密码或邮箱服务商生成的授权码。
SMTP_PASSWORD=your_smtp_authorization_code
# 发件人地址，通常与 SMTP_USERNAME 相同。
SMTP_FROM=your_email@example.com
# 收件人地址，多个地址以英文逗号分隔。
SMTP_TO=recipient@example.com
# 是否建立 SMTP SSL 连接；使用 465 端口时通常设为 true。
SMTP_USE_SSL=true
# 是否在普通连接上启用 STARTTLS；使用 587 端口时设为 true，并将 SMTP_USE_SSL 设为 false。
SMTP_STARTTLS=false
# SMTP 连接和发送超时，单位为秒。
SMTP_TIMEOUT=20
# 邮件标题前缀。
EMAIL_SUBJECT_PREFIX=重庆大学电费监控

# ==================== 数据与日志 ====================
# history.csv、history.png 和日志相关文件的保存目录；Docker 内固定为 /data。
DATA_DIR=.
# Loguru 日志级别，例如 DEBUG、INFO、WARNING 或 ERROR。
LOG_LEVEL=INFO

# ==================== 网络与重试 ====================
# 单次 HTTP 请求超时，单位为秒。
REQUEST_TIMEOUT=20
# 登录及验证码识别的最大尝试次数。
LOGIN_RETRIES=8

# ==================== 学校服务地址 ====================
# 重庆大学缴费平台首页地址，一般无需修改。
PORTAL_URL=http://card.cqu.edu.cn
# 虎溪校园学生公寓水电费页面地址，一般无需修改。
ELECTRICITY_URL=http://card.cqu.edu.cn:8080/charge/feeitem/singleItem?feeitemid=182
# 水电费项目编号，必须与 ELECTRICITY_URL 中的 feeitemid 一致。
FEE_ITEM_ID=182
