# 账号与宿舍
CQU_ACCOUNT=your_student_id
CQU_PASSWORD=your_query_password
CQU_ROOM=D1102
CQU_BUILDING=兰园1栋

# 定时任务
SCHEDULE_TIMES=00:00,12:00
TIMEZONE=Asia/Shanghai

# 邮件通知
EMAIL_ENABLED=false
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USERNAME=your_email@example.com
SMTP_PASSWORD=your_smtp_authorization_code
SMTP_FROM=your_email@example.com
SMTP_TO=recipient@example.com
SMTP_USE_SSL=true
SMTP_STARTTLS=false
SMTP_TIMEOUT=20
EMAIL_SUBJECT_PREFIX=重庆大学电费监控

# 数据保存与日志
DATA_DIR=.
LOG_LEVEL=INFO

# 抓取连接与重试
REQUEST_TIMEOUT=20
LOGIN_RETRIES=8

# 学校服务地址
